# Copy this file to .env and fill in values if you want LIVE MODE
# (LLM-enriched summaries/responses). The project runs perfectly well
# WITHOUT any of this filled in — it will automatically use DEMO_MODE
# (rule-based + classical ML only, no external API calls).

# Optional: OpenAI API key. Leave blank to stay in DEMO_MODE.
OPENAI_API_KEY=

# Optional: which OpenAI model to use if a key is provided.
OPENAI_MODEL=gpt-4o-mini

# Optional: force DEMO_MODE on/off explicitly (true/false).
# Leave unset to auto-detect based on whether OPENAI_API_KEY is set.
FORCE_DEMO_MODE=

# Optional: override the SQLite database file location.
DB_PATH=
